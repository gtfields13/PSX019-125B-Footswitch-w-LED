(kicad_wks
	(version 20231118)
	(generator "pl_editor")
	(generator_version "10.0")
	(setup
		(textsize 1.5 1.5)
		(linewidth 0.15)
		(textlinewidth 0.15)
		(left_margin 10)
		(right_margin 10)
		(top_margin 10)
		(bottom_margin 10)
	)
	(rect
		(name "")
		(start 107.46 31.46)
		(end -0.54 -0.54)
		(comment "rect around the title block")
	)
	(line
		(name "")
		(start 0 50 ltcorner)
		(end 2 50 ltcorner)
		(repeat 30)
		(incry 50)
	)
	(line
		(name "")
		(start 0 50 rtcorner)
		(end 2 50 rtcorner)
		(repeat 30)
		(incry 50)
	)
	(tbtext "Date: ${ISSUE_DATE}"
		(name "")
		(pos 84.46 4.36)
	)
	(line
		(name "")
		(start 107.46 2.96)
		(end -0.54 2.96)
	)
	(tbtext "${KICAD_VERSION}"
		(name "")
		(pos 106.46 1.56)
		(comment "Kicad version")
	)
	(line
		(name "")
		(start 107.46 5.96)
		(end -0.54 5.96)
	)
	(tbtext "Rev: ${REVISION}"
		(name "")
		(pos 21.46 4.36)
		(font bold)
	)
	(tbtext "Size: ${PAPER}"
		(name "")
		(pos 106.46 4.36)
		(comment "Paper format name")
	)
	(tbtext "Id: ${#}/${##}"
		(name "")
		(pos 21.46 1.56)
		(comment "Sheet id")
	)
	(line
		(name "")
		(start 107.46 9.96)
		(end -0.54 9.96)
	)
	(tbtext "Title: ${TITLE}"
		(name "")
		(pos 106.46 8.16)
		(font
			(face "Avenir Medium")
			(size 2 2)
		)
	)
	(tbtext "File: ${FILENAME}"
		(name "")
		(pos 106.46 11.76)
	)
	(line
		(name "")
		(start 107.46 15.96)
		(end -0.54 15.96)
	)
	(tbtext "Sheet: ${SHEETPATH}"
		(name "")
		(pos 106.46 14.46)
	)
	(tbtext "${COMPANY}"
		(name "")
		(pos 106.46 17.46)
		(font bold)
		(comment "Company name")
	)
	(tbtext "${COMMENT1}"
		(name "")
		(pos 106.46 20.46)
		(comment "Comment 0")
	)
	(tbtext "${COMMENT2}"
		(name "")
		(pos 106.46 23.46)
		(comment "Comment 1")
	)
	(tbtext "${COMMENT3}"
		(name "")
		(pos 106.46 26.46)
		(comment "Comment 2")
	)
	(line
		(name "")
		(start 87.46 5.96)
		(end 87.46 2.96)
	)
	(line
		(name "")
		(start 23.46 5.96)
		(end 23.46 -0.54)
	)
)
